{
  "name": "portfolio-v3",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    }
  },
  "scripts": {
    "sync:blog-assets": "node scripts/sync-blog-assets.mjs",
    "predev": "pnpm sync:blog-assets",
    "dev": "next dev --turbopack",
    "prebuild": "pnpm sync:blog-assets",
    "build": "next build --turbopack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@paper-design/shaders-react": "^0.0.80",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.2",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "next": "16.0.10",
    "openmeteo": "^1.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-twitter-embed": "^4.0.4",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.1",
    "remark-frontmatter": "^5.0.0",
    "shiki": "^3.15.0",
    "tailwind-merge": "^3.3.1",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@content-collections/core": "^0.12.0",
    "@content-collections/next": "^0.2.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jiti": "^2.6.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "4.119.0",
    "zod": "^4.1.12"
  }
}
